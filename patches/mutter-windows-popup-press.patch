+/*
+ * Context menus that take no grab, the way Chromium and Electron open
+ * theirs, get what meta-wayland-popup.c gives grabbing popups: a press
+ * outside one takes it down first and then reaches whatever it landed on.
+ * Otherwise the client spends a press on its own window closing the menu,
+ * and never sees a press anywhere else. Only popups hung from a single
+ * point are covered: context menus are; tooltips, completion lists and
+ * menus dropped from a button are not.
+ */
+static GList *point_popups = NULL;
+
+static gboolean
+surface_is_popup_of_client (MetaWaylandSurface *surface,
+                            struct wl_client   *client)
+{
+  MetaWindow *window;
+  MetaWaylandSurface *window_surface;
+
+  window = surface ? meta_wayland_surface_get_window (surface) : NULL;
+  window_surface = window ? meta_window_get_wayland_surface (window) : NULL;
+  if (!window_surface || !window_surface->resource)
+    return FALSE;
+
+  return (META_IS_WAYLAND_XDG_POPUP (window_surface->role) &&
+          wl_resource_get_client (window_surface->resource) == client);
+}
+
+/**
+ * meta_wayland_xdg_shell_dismiss_point_popups:
+ * @seat: the seat
+ * @event: a button press about to be delivered
+ *
+ * Returns: %TRUE if @event closed context menus and has been taken to be
+ *   delivered once they are gone.
+ */
+gboolean
+meta_wayland_xdg_shell_dismiss_point_popups (MetaWaylandSeat    *seat,
+                                             const ClutterEvent *event)
+{
+  MetaContext *context;
+  MetaBackend *backend;
+  ClutterBackend *clutter_backend;
+  ClutterSprite *sprite;
+  MetaWaylandSurface *surface;
+  g_autoptr (GPtrArray) resources = NULL;
+  GList *l, *next;
+
+  if (!point_popups)
+    return FALSE;
+
+  context = meta_wayland_compositor_get_context (seat->compositor);
+  backend = meta_context_get_backend (context);
+  clutter_backend = meta_backend_get_clutter_backend (backend);
+  sprite = clutter_backend_get_sprite (clutter_backend,
+                                       CLUTTER_STAGE (meta_backend_get_stage (backend)),
+                                       event);
+  if (!sprite ||
+      clutter_sprite_get_role (sprite) != CLUTTER_SPRITE_ROLE_POINTER)
+    return FALSE;
+
+  surface = meta_wayland_seat_get_current_surface (seat, CLUTTER_FOCUS (sprite));
+
+  resources = g_ptr_array_new ();
+  for (l = point_popups; l; l = next)
+    {
+      MetaWaylandXdgPopup *xdg_popup = l->data;
+
+      next = l->next;
+      if (surface_is_popup_of_client (surface,
+                                      wl_resource_get_client (xdg_popup->resource)))
+        continue;
+
+      /* Only once: a client that ignores this keeps its menu, and later
+       * presses are not held for it again. The client takes the menu
+       * down itself, submenus first; unmapping it here could leave a
+       * submenu without its parent, which is a protocol error. */
+      point_popups = g_list_delete_link (point_popups, l);
+      xdg_popup_send_popup_done (xdg_popup->resource);
+      g_ptr_array_add (resources, xdg_popup->resource);
+    }
+
+  if (resources->len == 0)
+    return FALSE;
+
+  meta_wayland_popup_replay_press (seat, event, resources);
+  return TRUE;
+}
