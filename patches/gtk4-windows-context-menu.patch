 gtk_get_current_event_time (void)
 {
--- a/gtk/gtkpopover.c
+++ b/gtk/gtkpopover.c
@@ -2408,11 +2408,68 @@ gtk_popover_get_autohide (GtkPopover *po
  *
  * Pops @popover up.
  */
+/* Windows opens a context menu when the secondary button is released.
+ * GTK applications pop theirs up from the press, and the menu then
+ * follows the X11 press-drag-release model: drag onto an item and let go
+ * to choose it. Someone used to Windows lets go as soon as the menu
+ * appears and picks whatever happens to be under the pointer.
+ *
+ * So a popover popped up while a press of the secondary button is being
+ * dispatched is held back, and shown once gtk_main_do_event() has
+ * dispatched that button's release. No release is left to choose with,
+ * and the menu waits for a separate click, as on Windows.
+ */
+static GtkPopover *deferred_popover;
+
+/* A drag, a popdown or another press means the menu is not wanted. */
+void
+gtk_popover_cancel_deferred (void)
+{
+  g_clear_weak_pointer (&deferred_popover);
+}
+
+/* Called by gtk_main_do_event() before it dispatches @event. */
+void
+gtk_popover_track_button (GdkEvent *event)
+{
+  if (gdk_event_get_event_type (event) == GDK_BUTTON_PRESS)
+    gtk_popover_cancel_deferred ();
+}
+
+/* Called by gtk_main_do_event() once it has dispatched @event. */
+void
+gtk_popover_show_deferred (GdkEvent *event)
+{
+  GtkPopover *popover;
+
+  if (deferred_popover == NULL ||
+      gdk_event_get_event_type (event) != GDK_BUTTON_RELEASE ||
+      gdk_button_event_get_button (event) != GDK_BUTTON_SECONDARY)
+    return;
+
+  popover = g_object_ref (deferred_popover);
+  gtk_popover_cancel_deferred ();
+  gtk_widget_set_visible (GTK_WIDGET (popover), TRUE);
+  g_object_unref (popover);
+}
+
 void
 gtk_popover_popup (GtkPopover *popover)
 {
+  GdkEvent *event;
+
   g_return_if_fail (GTK_IS_POPOVER (popover));
 
+  event = gtk_get_current_event ();
+  if (event &&
+      gdk_event_get_event_type (event) == GDK_BUTTON_PRESS &&
+      gdk_button_event_get_button (event) == GDK_BUTTON_SECONDARY &&
+      !gtk_widget_get_visible (GTK_WIDGET (popover)))
+    {
+      g_set_weak_pointer (&deferred_popover, popover);
+      return;
+    }
+
   gtk_widget_set_visible (GTK_WIDGET (popover), TRUE);
 }
 
@@ -2461,6 +2518,9 @@ gtk_popover_popdown (GtkPopover *popover
 {
   g_return_if_fail (GTK_IS_POPOVER (popover));
 
+  if (deferred_popover == popover)
+    gtk_popover_cancel_deferred ();
+
   if (!gtk_widget_get_visible (GTK_WIDGET (popover)))
     return;
 
