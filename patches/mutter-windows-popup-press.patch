+static struct wl_resource *
+meta_wayland_popup_surface_get_resource (MetaWaylandPopupSurface *popup_surface)
+{
+  MetaWaylandPopupSurfaceInterface *iface =
+    META_WAYLAND_POPUP_SURFACE_GET_IFACE (popup_surface);
+
+  return iface->get_resource ? iface->get_resource (popup_surface) : NULL;
+}
+
+/*
+ * A press outside a popup grab, the Windows way.
+ *
+ * Without this the press only ends the grab: a client's own window gets it
+ * while the client still believes its menu is open, and toolkits that do
+ * not repost it there (Chromium on Linux, for one) spend it on closing the
+ * menu. Another client's window or the shell gets nothing at all. A right
+ * click elsewhere therefore needs a second click to open a menu there, and
+ * a right-button mouse gesture started with the menu open never starts.
+ *
+ * Instead the press is held, the popups are taken down, and once the client
+ * has destroyed them (or after a short timeout) the press, with anything
+ * that arrived meanwhile, is put back and reaches whatever it landed on.
+ * meta-wayland-xdg-shell.c does the same for context menus that take no
+ * grab at all, which is how Chromium opens them.
+ */
+
+typedef struct _PopupReplay PopupReplay;
+
+typedef struct
+{
+  struct wl_listener listener;
+  PopupReplay *replay;
+} PopupReplayWatch;
+
+struct _PopupReplay
+{
+  MetaWaylandSeat *seat;
+  MetaWaylandEventHandler *handler;
+  GPtrArray *events;
+  GPtrArray *watches;
+  int n_pending;
+  guint timeout_id;
+  guint idle_id;
+  gboolean drop_implicit_grab;
+};
+
+static PopupReplay *pending_replay = NULL;
+
+/* Runs from the main loop only, never inside event delivery. */
+static void
+popup_replay_finish (PopupReplay *replay)
+{
+  MetaWaylandInput *input = meta_wayland_seat_get_input (replay->seat);
+  MetaContext *context =
+    meta_wayland_compositor_get_context (replay->seat->compositor);
+  MetaBackend *backend = meta_context_get_backend (context);
+  ClutterStage *stage = CLUTTER_STAGE (meta_backend_get_stage (backend));
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  g_autoptr (GPtrArray) events = g_steal_pointer (&replay->events);
+  gboolean drop_implicit_grab = replay->drop_implicit_grab;
+  guint i;
+
+  g_clear_handle_id (&replay->timeout_id, g_source_remove);
+  g_clear_handle_id (&replay->idle_id, g_source_remove);
+
+  for (i = 0; i < replay->watches->len; i++)
+    {
+      PopupReplayWatch *watch = g_ptr_array_index (replay->watches, i);
+
+      if (watch->replay)
+        wl_list_remove (&watch->listener.link);
+      g_free (watch);
+    }
+  g_ptr_array_free (replay->watches, TRUE);
+
+  if (replay->handler)
+    meta_wayland_input_detach_event_handler (input, replay->handler);
+
+  if (pending_replay == replay)
+    pending_replay = NULL;
+  g_free (replay);
+
+  /* A press that arrived while the stage was grabbed went to the grab's
+   * actor first, and Clutter took it as the start of an implicit grab
+   * there. That actor has gone with the grab and the press is about to
+   * arrive again, so drop the stale grab: otherwise the release leaves
+   * Clutter believing a button is still down, and the shell stops getting
+   * pointer events. */
+  if (drop_implicit_grab)
+    {
+      ClutterSprite *sprite =
+        clutter_backend_get_sprite (clutter_backend, stage,
+                                    g_ptr_array_index (events, 0));
+
+      if (sprite)
+        clutter_stage_maybe_lost_implicit_grab (stage, sprite);
+    }
+
+  /* The grab has gone, so these reach what is under the pointer. */
+  for (i = 0; i < events->len; i++)
+    clutter_event_put (g_ptr_array_index (events, i));
+}
+
+static gboolean
+popup_replay_timeout (gpointer user_data)
+{
+  PopupReplay *replay = user_data;
+
+  replay->timeout_id = 0;
+  popup_replay_finish (replay);
+
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+popup_replay_idle (gpointer user_data)
+{
+  PopupReplay *replay = user_data;
+
+  replay->idle_id = 0;
+  popup_replay_finish (replay);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+on_popup_resource_destroyed (struct wl_listener *listener,
+                             void               *data)
+{
+  PopupReplayWatch *watch = wl_container_of (listener, watch, listener);
+  PopupReplay *replay = watch->replay;
+
+  wl_list_remove (&watch->listener.link);
+  watch->replay = NULL;
+
+  /* Not from inside the client's request: put the events back from the
+   * main loop. */
+  if (--replay->n_pending == 0 && !replay->idle_id)
+    replay->idle_id = g_idle_add (popup_replay_idle, replay);
+}
+
+static MetaWaylandSurface *
+replay_gate_get_focus_surface (MetaWaylandEventHandler *handler,
+                               ClutterFocus            *focus,
+                               gpointer                 user_data)
+{
+  return meta_wayland_event_handler_chain_up_get_focus_surface (handler,
+                                                                focus);
+}
+
+static void
+replay_gate_focus (MetaWaylandEventHandler *handler,
+                   ClutterFocus            *focus,
+                   MetaWaylandSurface      *surface,
+                   gpointer                 user_data)
+{
+  meta_wayland_event_handler_chain_up_focus (handler, focus, surface);
+}
+
+static gboolean
+replay_gate_button (MetaWaylandEventHandler *handler,
+                    const ClutterEvent      *event,
+                    gpointer                 user_data)
+{
+  PopupReplay *replay = user_data;
+  ClutterEventType event_type = clutter_event_type (event);
+
+  if (event_type != CLUTTER_BUTTON_PRESS &&
+      event_type != CLUTTER_BUTTON_RELEASE)
+    return CLUTTER_EVENT_PROPAGATE;
+
+  /* Held so the client sees them after the press, in order. */
+  g_ptr_array_add (replay->events, clutter_event_copy (event));
+
+  return CLUTTER_EVENT_STOP;
+}
+
+static MetaWaylandEventInterface replay_gate_interface = {
+  replay_gate_get_focus_surface,
+  replay_gate_focus,
+  NULL, /* motion */
+  replay_gate_button, /* press */
+  replay_gate_button, /* release */
+};
+
+static void
+popup_replay_watch (PopupReplay *replay,
+                    GPtrArray   *resources)
+{
+  guint i;
+
+  for (i = 0; i < resources->len; i++)
+    {
+      PopupReplayWatch *watch;
+
+      watch = g_new0 (PopupReplayWatch, 1);
+      watch->replay = replay;
+      watch->listener.notify = on_popup_resource_destroyed;
+      wl_resource_add_destroy_listener (g_ptr_array_index (resources, i),
+                                        &watch->listener);
+      g_ptr_array_add (replay->watches, watch);
+      replay->n_pending++;
+    }
+}
+
+/**
+ * meta_wayland_popup_replay_press:
+ * @seat: the seat the press came from
+ * @event: the press, which the caller has to stop
+ * @resources: (element-type wl_resource): the client objects whose
+ *   destruction means the client has taken its popups down
+ *
+ * Holds @event, and any presses and releases after it, until the client has
+ * destroyed all of @resources or a short time has passed, then puts them
+ * back so they reach whatever is under the pointer then.
+ */
+void
+meta_wayland_popup_replay_press (MetaWaylandSeat    *seat,
+                                 const ClutterEvent *event,
+                                 GPtrArray          *resources)
+{
+  MetaWaylandInput *input = meta_wayland_seat_get_input (seat);
+  MetaContext *context = meta_wayland_compositor_get_context (seat->compositor);
+  MetaBackend *backend = meta_context_get_backend (context);
+  ClutterStage *stage = CLUTTER_STAGE (meta_backend_get_stage (backend));
+  gboolean counted = clutter_stage_get_grab_actor (stage) != NULL;
+  PopupReplay *replay;
+
+  /* A popup grab that began while a press was held can only have been
+   * ended by a press that came through it: hold that one behind the
+   * first, and wait for these popups as well. */
+  if (pending_replay)
+    {
+      replay = pending_replay;
+      g_ptr_array_add (replay->events, clutter_event_copy (event));
+      popup_replay_watch (replay, resources);
+      replay->drop_implicit_grab |= counted;
+      if (replay->n_pending > 0)
+        g_clear_handle_id (&replay->idle_id, g_source_remove);
+      return;
+    }
+
+  replay = g_new0 (PopupReplay, 1);
+  replay->seat = seat;
+  replay->events =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) clutter_event_free);
+  replay->watches = g_ptr_array_new ();
+  replay->drop_implicit_grab = counted;
+  g_ptr_array_add (replay->events, clutter_event_copy (event));
+  popup_replay_watch (replay, resources);
+
+  replay->handler =
+    meta_wayland_input_attach_event_handler (input,
+                                             &replay_gate_interface,
+                                             TRUE, replay);
+  replay->timeout_id = g_timeout_add (POPUP_REPLAY_TIMEOUT_MS,
+                                      popup_replay_timeout, replay);
+  if (replay->n_pending == 0)
+    replay->idle_id = g_idle_add (popup_replay_idle, replay);
+
+  pending_replay = replay;
+}
+
+/* Whether a press should end the grab and go on to what it landed on. */
+static gboolean
+press_passes_through (MetaWaylandPopupGrab *popup_grab,
+                      const ClutterEvent   *event)
+{
+  MetaWaylandSeat *seat = popup_grab->seat;
+  MetaContext *context = meta_wayland_compositor_get_context (seat->compositor);
+  MetaBackend *backend = meta_context_get_backend (context);
+  ClutterStage *stage = CLUTTER_STAGE (meta_backend_get_stage (backend));
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterFocus *focus;
+  MetaWaylandSurface *surface;
+  MetaWindow *window;
+  MetaWaylandPopup *popup;
+  MetaWaylandPopup *root = NULL;
+
+  focus = CLUTTER_FOCUS (clutter_backend_get_sprite (clutter_backend,
+                                                     stage, event));
+  surface = meta_wayland_seat_get_current_surface (seat, focus);
+  window = surface ? meta_wayland_surface_get_window (surface) : NULL;
+
+  wl_list_for_each (popup, &popup_grab->all_popups, link)
+    {
+      MetaWaylandSurface *popup_surface =
+        meta_wayland_popup_surface_get_surface (popup->popup_surface);
+
+      if (surface == popup_surface ||
+          (window && window == meta_wayland_surface_get_window (popup_surface)))
+        return FALSE;
+
+      /* The list runs newest first, so this ends on the first popup. */
+      root = popup;
+    }
+
+  /* A menu dropped down from a button keeps a press on that button, so a
+   * second click on it closes the menu instead of opening it again. A
+   * context menu hangs from a single point, which this never matches. */
+  if (root)
+    {
+      MetaWaylandSurface *root_surface =
+        meta_wayland_popup_surface_get_surface (root->popup_surface);
+      MetaWindow *root_window = meta_wayland_surface_get_window (root_surface);
+      MetaPlacementRule *rule = root_window ? root_window->placement.rule : NULL;
+
+      if (rule && rule->anchor_rect.width > 1 && rule->anchor_rect.height > 1)
+        {
+          float x, y;
+          int anchor_x = rule->parent_rect.x + rule->anchor_rect.x;
+          int anchor_y = rule->parent_rect.y + rule->anchor_rect.y;
+
+          clutter_event_get_coords (event, &x, &y);
+          if (x >= anchor_x && x < anchor_x + rule->anchor_rect.width &&
+              y >= anchor_y && y < anchor_y + rule->anchor_rect.height)
+            return FALSE;
+        }
+    }
+
+  return TRUE;
+}
