 static gboolean
+popup_grab_press (MetaWaylandEventHandler *handler,
+                  const ClutterEvent      *event,
+                  gpointer                 user_data)
+{
+  MetaWaylandPopupGrab *popup_grab = user_data;
+  g_autoptr (GPtrArray) resources = NULL;
+  MetaWaylandPopup *popup;
+
+  /* Touch keeps closing popups on release, as before. */
+  if (clutter_event_type (event) != CLUTTER_BUTTON_PRESS ||
+      !press_passes_through (popup_grab, event))
+    return CLUTTER_EVENT_PROPAGATE;
+
+  resources = g_ptr_array_new ();
+  wl_list_for_each (popup, &popup_grab->all_popups, link)
+    {
+      struct wl_resource *resource =
+        meta_wayland_popup_surface_get_resource (popup->popup_surface);
+
+      if (resource)
+        g_ptr_array_add (resources, resource);
+    }
+
+  meta_wayland_popup_replay_press (popup_grab->seat, event, resources);
+  /* This frees the grab, and detaches this handler, once the last popup
+   * is gone; nothing below may touch either. */
+  meta_wayland_popup_grab_finish (popup_grab);
+
+  return CLUTTER_EVENT_STOP;
+}
