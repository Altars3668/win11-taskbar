+/* Windows opens a context menu when the secondary button is released.
+ * GTK applications pop theirs up from the press, and the menu then
+ * follows the X11 press-drag-release model: drag onto an item and let go
+ * to choose it. Someone used to Windows lets go as soon as the menu
+ * appears and picks whatever happens to be under the pointer.
+ *
+ * So a top-level menu popped up while the secondary button is down is
+ * held back, and shown once gtk_main_do_event() has dispatched that
+ * button's release. No release is left to choose with, and the menu
+ * waits for a separate click, as on Windows. The button is followed in
+ * event order rather than asked of the device, because the release can
+ * reach GDK before the press has been dispatched.
+ */
+static gboolean secondary_button_down;
+
+/* The context menu on screen, if any; see _gtk_menu_dismiss_for_press(). */
+static GtkMenu *shown_context_menu;
+
+static struct
+{
+  GtkMenu             *menu;         /* weak */
+  GdkDevice           *device;
+  GtkWidget           *parent_menu_item;
+  GtkMenuPositionFunc  func;
+  gpointer             data;
+  GDestroyNotify       destroy;
+  guint                button;
+} deferred_popup;
+
+static void
+deferred_popup_clear (gboolean free_data)
+{
+  if (deferred_popup.menu)
+    g_object_remove_weak_pointer (G_OBJECT (deferred_popup.menu),
+                                  (gpointer *) &deferred_popup.menu);
+  if (free_data && deferred_popup.destroy)
+    deferred_popup.destroy (deferred_popup.data);
+  g_clear_object (&deferred_popup.device);
+  g_clear_object (&deferred_popup.parent_menu_item);
+  memset (&deferred_popup, 0, sizeof deferred_popup);
+}
+
+/* A drag, a popdown or another press means the menu is not wanted. */
+void
+_gtk_menu_cancel_deferred_popup (void)
+{
+  deferred_popup_clear (TRUE);
+}
+
+/* Called by gtk_main_do_event() before it dispatches @event. */
+void
+_gtk_menu_track_button (const GdkEvent *event)
+{
+  switch ((guint) event->type)
+    {
+    case GDK_BUTTON_PRESS:
+      _gtk_menu_cancel_deferred_popup ();
+      secondary_button_down =
+        event->button.button == GDK_BUTTON_SECONDARY ||
+        (event->button.state & GDK_BUTTON3_MASK) != 0;
+      break;
+
+    case GDK_MOTION_NOTIFY:
+      /* Recover from a release that never reached us. */
+      if (!(event->motion.state & GDK_BUTTON3_MASK))
+        secondary_button_down = FALSE;
+      break;
+
+    case GDK_BUTTON_RELEASE:
+      if (event->button.button == GDK_BUTTON_SECONDARY)
+        secondary_button_down = FALSE;
+      break;
+
+    default:
+      break;
+    }
+}
+
+/* Whether @target is inside @root or one of its submenus. */
+static gboolean
+menu_contains (GtkMenu   *root,
+               GtkWidget *target)
+{
+  GtkWidget *toplevel = gtk_widget_get_toplevel (target);
+  GtkWidget *shell = GTK_IS_BIN (toplevel) ? gtk_bin_get_child (GTK_BIN (toplevel)) : NULL;
+
+  for (; GTK_IS_MENU_SHELL (shell); shell = GTK_MENU_SHELL (shell)->priv->parent_menu_shell)
+    if (shell == GTK_WIDGET (root))
+      return TRUE;
+
+  return FALSE;
+}
+
+/* The other half of the Windows model. There, a press outside an open
+ * context menu closes it and still goes to whatever is under the pointer:
+ * a right click elsewhere opens the menu there in one click, and a left
+ * click elsewhere acts there. GTK spends that press on closing the menu.
+ *
+ * Called by gtk_main_do_event() before it works out where a press goes.
+ * Where the press landed is asked of the device, because during the menu's
+ * grab GDK reports it on the menu's own window, at coordinates outside it.
+ * Cancelling the menu releases the grab; the press is then sent to the
+ * window it landed on, and %TRUE says it has been dispatched. Only context
+ * menus: a click on the button that dropped a menu down must close that
+ * menu, not open it again.
+ */
+gboolean
+_gtk_menu_dismiss_for_press (GdkEvent *event)
+{
+  GtkMenu *menu = shown_context_menu;
+  GtkWidget *target = NULL;
+  GdkDevice *device;
+  GdkWindow *under;
+  GdkEvent *moved;
+  gdouble x, y;
+
+  if (event->type != GDK_BUTTON_PRESS || menu == NULL ||
+      !GTK_MENU_SHELL (menu)->priv->active)
+    return FALSE;
+
+  device = gdk_event_get_device (event);
+  under = device ? gdk_device_get_window_at_position_double (device, &x, &y) : NULL;
+  if (under)
+    gdk_window_get_user_data (under, (gpointer *) &target);
+  if (target == NULL || menu_contains (menu, target))
+    return FALSE;
+
+  gtk_menu_shell_cancel (GTK_MENU_SHELL (menu));
+
+  if (event->any.window == under)
+    return FALSE;
+
+  moved = gdk_event_copy (event);
+  g_object_unref (moved->any.window);
+  moved->any.window = g_object_ref (under);
+  moved->button.x = x;
+  moved->button.y = y;
+  gtk_main_do_event (moved);
+  gdk_event_free (moved);
+
+  return TRUE;
+}
+
 static void
 gtk_menu_popup_internal (GtkMenu             *menu,
                          GdkDevice           *device,
@@ -1834,6 +1977,25 @@ gtk_menu_popup_internal (GtkMenu
   g_return_if_fail (GTK_IS_MENU (menu));
   g_return_if_fail (device == NULL || GDK_IS_DEVICE (device));
 
+  if (parent_menu_shell == NULL && secondary_button_down)
+    {
+      deferred_popup_clear (TRUE);
+      deferred_popup.menu = menu;
+      g_object_add_weak_pointer (G_OBJECT (menu),
+                                 (gpointer *) &deferred_popup.menu);
+      deferred_popup.device = device ? g_object_ref (device) : NULL;
+      deferred_popup.parent_menu_item =
+        parent_menu_item ? g_object_ref (parent_menu_item) : NULL;
+      deferred_popup.func = func;
+      deferred_popup.data = data;
+      deferred_popup.destroy = destroy;
+      deferred_popup.button = button;
+      return;
+    }
+
+  if (parent_menu_shell == NULL && button == GDK_BUTTON_SECONDARY)
+    g_set_weak_pointer (&shown_context_menu, menu);
+
   _gtk_tooltip_hide_in_display (gtk_widget_get_display (GTK_WIDGET (menu)));
   display = gtk_widget_get_display (GTK_WIDGET (menu));
 
@@ -2026,6 +2188,46 @@ gtk_menu_popup_internal (GtkMenu
   _gtk_menu_shell_update_mnemonics (menu_shell);
 }
 
+/* Called by gtk_main_do_event() once it has dispatched @event. */
+void
+_gtk_menu_show_deferred_popup (const GdkEvent *event)
+{
+  GtkMenu *menu = deferred_popup.menu;
+  GdkDevice *device;
+  GtkWidget *parent_menu_item;
+  GtkMenuPositionFunc func;
+  gpointer data;
+  GDestroyNotify destroy;
+  guint button;
+
+  if (event->type != GDK_BUTTON_RELEASE ||
+      event->button.button != GDK_BUTTON_SECONDARY)
+    return;
+
+  if (menu == NULL)
+    {
+      deferred_popup_clear (TRUE);
+      return;
+    }
+
+  /* The position data passes to the menu, so keep it alive. */
+  device = deferred_popup.device ? g_object_ref (deferred_popup.device) : NULL;
+  parent_menu_item = deferred_popup.parent_menu_item ?
+    g_object_ref (deferred_popup.parent_menu_item) : NULL;
+  func = deferred_popup.func;
+  data = deferred_popup.data;
+  destroy = deferred_popup.destroy;
+  button = deferred_popup.button;
+  deferred_popup_clear (FALSE);
+
+  gtk_menu_popup_internal (menu, device, NULL, parent_menu_item,
+                           func, data, destroy, button,
+                           gdk_event_get_time (event));
+
+  g_clear_object (&device);
+  g_clear_object (&parent_menu_item);
+}
+
 /**
  * gtk_menu_popup_for_device:
  * @menu: a #GtkMenu
@@ -2518,6 +2720,11 @@ gtk_menu_popdown (GtkMenu *menu)
 
   g_return_if_fail (GTK_IS_MENU (menu));
 
