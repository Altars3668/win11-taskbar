@@ -1698,6 +1702,29 @@ gtk_main_do_event (GdkEvent *event)
   /* check whether there is a grab in effect... */
   grab_widget = gtk_window_group_get_current_grab (window_group);
 
+  /* A press outside an autohide popover, which GDK has already hidden.
+   * Pop the popover down now, so that its grab is gone before the press is
+   * routed. A context menu then lets the press through to what it landed
+   * on, as Windows does: a right click elsewhere opens a menu there, a left
+   * click elsewhere acts there. Any other popover keeps the press, so a
+   * click on the button that opened a menu only closes that menu.
+   */
+  if (gdk_event_get_event_type (event) == GDK_BUTTON_PRESS)
+    {
+      while (GTK_IS_POPOVER (grab_widget) &&
+             gtk_popover_get_autohide (GTK_POPOVER (grab_widget)) &&
+             target_widget != grab_widget &&
+             !gtk_widget_is_ancestor (target_widget, grab_widget))
+        {
+          gboolean through = gtk_popover_is_context_menu (GTK_POPOVER (grab_widget));
+
+          gtk_popover_popdown (GTK_POPOVER (grab_widget));
+          if (!through)
+            goto cleanup;
+          grab_widget = gtk_window_group_get_current_grab (window_group);
+        }
+    }
+
   /* If the grab widget is an ancestor of the event widget
    * then we send the event to the original event widget.
    * This is the key to implementing modality. This also applies
@@ -1800,6 +1827,8 @@ gtk_main_do_event (GdkEvent *event)
   g_object_unref (target_widget);
 
  cleanup:
+  gtk_popover_show_deferred (event);
+
   tmp_list = current_events;
   current_events = g_list_remove_link (current_events, tmp_list);
   g_list_free_1 (tmp_list);
@@ -1922,6 +1951,13 @@ gtk_grab_remove (GtkWidget *widget)
     }
 }
 
+/* The event gtk_main_do_event() is dispatching, if any. */
+GdkEvent *
+gtk_get_current_event (void)
+{
+  return current_events ? current_events->data : NULL;
+}
