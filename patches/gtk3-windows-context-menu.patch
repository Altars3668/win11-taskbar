+    _gtk_menu_cancel_deferred_popup ();
+  if (shown_context_menu == menu)
+    g_clear_weak_pointer (&shown_context_menu);
+
   menu_shell = GTK_MENU_SHELL (menu);
   priv = menu->priv;
 
